# Placeholders only. The application reads environment variables, not this file.
CLIENT_MODE=mock
DRY_RUN=true
REFILL_THRESHOLD_GB=0.30
REFILL_COOLDOWN_SECONDS=600
STATE_DB_PATH=.state/refill.sqlite3
VERIFY_INITIAL_DELAY_SECONDS=12
VERIFY_POLL_INTERVAL_SECONDS=5
VERIFY_ATTEMPTS=3
HTTP_TIMEOUT_SECONDS=20

# Optional access-only mode for one short run; no automatic renewal in this mode.
LIDL_ACCESS_TOKEN=

# Renewable HTTP mode: generate a Fernet key once and retain it securely.
# Tokens and published client settings are encrypted in this ignored state file.
LIDL_TOKEN_STATE_KEY=
LIDL_TOKEN_STATE_PATH=.state/session.sqlite3

# Simulation only; no account access, including when DRY_RUN=false.
MOCK_REMAINING_DATA=0.47 GB
MOCK_REFILL_OUTCOME=success
MOCK_UPDATE_AFTER_READS=0

# One-time bootstrap_session.py login only; remove these from the runtime environment.
LIDL_USERNAME=
LIDL_PASSWORD=

# Optional override of published portal client settings. Usually leave unset.
LIDL_CLIENT_ID=
LIDL_CLIENT_SECRET=
